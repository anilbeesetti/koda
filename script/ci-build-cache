#!/usr/bin/env python3
"""Invalidate workspace artifacts whose cached mtimes can hide changed source."""

import argparse
import os
from pathlib import Path
import subprocess


def clean_workspace(target_dir, target=None):
    if not Path(target_dir).is_dir():
        return
    # A cache built after checkout can make Cargo consider older, different
    # workspace source fresh. Keep immutable third-party dependency artifacts.
    command = [os.environ.get("CARGO", "cargo"), "clean", "--locked", "--workspace",
               "--profile", "dev", "--target-dir", str(target_dir)]
    if target:
        command += ["--target", target]
    subprocess.run(command, check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--target-dir", type=Path, default=Path("target"))
    parser.add_argument("--include-test-extension", action="store_true")
    args = parser.parse_args()
    clean_workspace(args.target_dir)
    if args.include_test_extension:
        extension_target = Path("extensions/test-extension/target")
        clean_workspace(extension_target)
        clean_workspace(extension_target, "wasm32-wasip2")


if __name__ == "__main__":
    main()
