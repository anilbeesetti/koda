#!/usr/bin/env python3
"""Atomically reserve year.month.day.hour.minute tags, reusing them on retries.

Tag and release timestamps use Asia/Calcutta. Colliding releases wait for the next
available minute, so the format never needs a suffix or a fabricated future date.
Annotated tags record the run ID and point at the selected workflow commit. Failed
builds leave a reserved tag; rerunning that workflow reuses it.
"""

import datetime
import json
import os
import re
import subprocess
import time
from zoneinfo import ZoneInfo


def api(endpoint, payload):
    result = subprocess.run(
        ["gh", "api", "--method", "POST", endpoint, "--input", "-"],
        input=json.dumps(payload), capture_output=True, text=True,
    )
    if result.returncode:
        # Only an existing ref is a timestamp collision. Authentication errors,
        # tag rules, validation failures and network errors must stop the run.
        try:
            error = json.loads(result.stdout)
        except json.JSONDecodeError:
            error = {}
        if error.get("message") == "Reference already exists":
            return None
        raise RuntimeError(result.stderr.strip() or result.stdout.strip())
    return json.loads(result.stdout)


def reserve(repository, run_id, commit, clock=None, wait=time.sleep, channel="stable"):
    if channel not in ("stable", "dev"):
        raise ValueError(f"Unsupported release channel: {channel}")
    clock = clock or (lambda: datetime.datetime.now(ZoneInfo("Asia/Calcutta")))
    prefix = "dev-" if channel == "dev" else ""
    name = "Dev" if channel == "dev" else "Main"
    marker = f"{name} macOS release for workflow run {run_id}"
    tags = subprocess.check_output(
        ["git", "for-each-ref", "--format=%(refname:strip=2)%09%(contents:subject)%09%(*objectname)", "refs/tags"],
        text=True,
    )
    for line in tags.splitlines():
        tag, subject, target = line.split("\t", 2)
        if subject == marker:
            if target != commit or not re.fullmatch(prefix + r"\d{4}(?:\.\d{2}){4}", tag):
                raise RuntimeError("Reserved tag does not match this run's commit or timestamp format")
            return tag

    deadline = time.monotonic() + 10 * 60
    while time.monotonic() < deadline:
        version = prefix + clock().strftime("%Y.%m.%d.%H.%M")
        tag = api(f"repos/{repository}/git/tags", {
            "tag": version, "message": marker, "object": commit, "type": "commit",
        })
        reference = api(f"repos/{repository}/git/refs", {
            "ref": f"refs/tags/{version}", "sha": tag["sha"],
        })
        if reference is not None:
            return version
        print(f"Timestamp {version} is reserved; waiting for an available minute.", flush=True)
        wait(10)
    raise RuntimeError("No release timestamp became available within ten minutes")


def main():
    tag = reserve(os.environ["GITHUB_REPOSITORY"], os.environ["GITHUB_RUN_ID"], os.environ["GITHUB_SHA"],
                  channel=os.environ.get("RELEASE_CHANNEL", "stable"))
    version = tag.removeprefix("dev-")
    with open(os.environ["GITHUB_OUTPUT"], "a") as output:
        output.write(f"version={version}\n")
        output.write(f"tag={tag}\n")
    print(f"Reserved release {tag} for {os.environ['GITHUB_SHA']}")


if __name__ == "__main__":
    main()
