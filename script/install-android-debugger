#!/usr/bin/env sh
# Compatibility entry point. Cargo builds the Rust installer; installation,
# revision checks and copying are implemented by android_debugger, not this shell.
set -eu
repository=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repository"
exec cargo run -p android_debugger --bin android-debugger -- install target/android-ide/dependencies/kotlin-debug-adapter
