+@NoMutableState
+class FirCompositeSymbolProvider(session: FirSession, val providers: List<FirSymbolProvider>) : FirSymbolProvider(session) {
+    private fun indexProviders(namesForProvider: (FirSymbolProvider) -> Set<Name>?): Pair<Map<Name, List<FirSymbolProvider>>, List<FirSymbolProvider>> {
+        val providersByName = mutableMapOf<Name, MutableList<FirSymbolProvider>>()
+        val unknownProviders = mutableListOf<FirSymbolProvider>()
+        // Unknown name sets participate in every lookup, in the original provider order.
+        for (provider in providers) {
+            val names = namesForProvider(provider)
+            if (names == null) {
+                unknownProviders.add(provider)
+                providersByName.values.forEach { it.add(provider) }
+            } else {
+                names.forEach { name -> providersByName.getOrPut(name) { unknownProviders.toMutableList() }.add(provider) }
+            }
+        }
+        return providersByName to unknownProviders
+    }
+
+    private val callableNamesByPackage by session.firCachesFactory.createPossiblySoftLazyValue {
+        session.firCachesFactory.createCache { packageName: FqName ->
+            indexProviders { it.symbolNamesProvider.getTopLevelCallableNamesInPackage(packageName) }
+        }
+    }
+
+    private val classifierNamesByPackage by session.firCachesFactory.createPossiblySoftLazyValue {
+        session.firCachesFactory.createCache { packageName: FqName ->
+            indexProviders { if (it.symbolNamesProvider.mayHaveSyntheticFunctionTypes) null else it.symbolNamesProvider.getTopLevelClassifierNamesInPackage(packageName) }
+        }
+    }
+
+    private fun callableProviders(packageName: FqName, name: Name): List<FirSymbolProvider> {
+        if (name.isSpecial) return providers
+        val (providersByName, unknownProviders) = callableNamesByPackage.getValue(packageName)
+        return providersByName[name] ?: unknownProviders
+    }
+
+    override val symbolNamesProvider: FirSymbolNamesProvider = FirCompositeCachedSymbolNamesProvider.fromSymbolProviders(session, providers)
+
+    override fun getTopLevelCallableSymbols(packageFqName: FqName, name: Name): List<FirCallableSymbol<*>> {
+        return callableProviders(packageFqName, name).flatMap { it.getTopLevelCallableSymbols(packageFqName, name) }
+    }
+
+    @FirSymbolProviderInternals
+    override fun getTopLevelCallableSymbolsTo(destination: MutableList<FirCallableSymbol<*>>, packageFqName: FqName, name: Name) {
+        destination += getTopLevelCallableSymbols(packageFqName, name)
+    }
+
+    @FirSymbolProviderInternals
+    override fun getTopLevelFunctionSymbolsTo(destination: MutableList<FirNamedFunctionSymbol>, packageFqName: FqName, name: Name) {
+        callableProviders(packageFqName, name).forEach {
+            it.getTopLevelFunctionSymbolsTo(destination, packageFqName, name)
+        }
+    }
+
+    @FirSymbolProviderInternals
+    override fun getTopLevelPropertySymbolsTo(destination: MutableList<FirPropertySymbol>, packageFqName: FqName, name: Name) {
+        callableProviders(packageFqName, name).forEach {
+            it.getTopLevelPropertySymbolsTo(destination, packageFqName, name)
+        }
+    }
+
+    override fun hasPackage(fqName: FqName): Boolean {
+        return providers.any { it.hasPackage(fqName) }
+    }
+
+    override fun getClassLikeSymbolByClassId(classId: ClassId): FirClassLikeSymbol<*>? {
+        val name = classId.outermostClassId.shortClassName
+        val candidates = if (name.isSpecial) providers else {
+            val (providersByName, unknownProviders) = classifierNamesByPackage.getValue(classId.packageFqName)
+            providersByName[name] ?: unknownProviders
+        }
+        return candidates.firstNotNullOfOrNull { it.getClassLikeSymbolByClassId(classId) }
+    }
+
+}
