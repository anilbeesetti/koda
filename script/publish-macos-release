#!/usr/bin/env bash
set -euo pipefail

: "${RELEASE_VERSION:?}"
: "${GITHUB_SHA:?}"
: "${GITHUB_REPOSITORY:?}"

channel="${RELEASE_CHANNEL:-stable}"
tag="${RELEASE_TAG:-$RELEASE_VERSION}"
prerelease=false
app_name="Koda"
asset_name="Koda"
case "$channel" in
    stable) test "$tag" = "$RELEASE_VERSION" ;;
    dev)
        test "$tag" = "dev-$RELEASE_VERSION"
        prerelease=true
        app_name="Koda Dev"
        asset_name="Koda-Dev"
        ;;
    *) echo "Unsupported release channel: $channel" >&2; exit 1 ;;
esac

test "$(git rev-parse "refs/tags/$tag^{commit}")" = "$GITHUB_SHA"
for architecture in aarch64; do
    test -s "release-assets/$asset_name-$RELEASE_VERSION-macos-$architecture.dmg"
    test -s "release-assets/koda-remote-server-$tag-macos-$architecture.gz"
    (cd release-assets && sha256sum --check "SHA256SUMS-macos-$architecture.txt")
done

notes=$(mktemp)
trap 'rm -f "$notes"' EXIT
cat > "$notes" <<EOF
Optimized macOS $app_name build of commit $GITHUB_SHA.

Version: $RELEASE_VERSION (Asia/Calcutta). Tag: $tag. Channel: $channel.

Download the aarch64 DMG for Apple Silicon Macs.
The apps are ad-hoc signed and are not Apple notarized. macOS may require
allowing the application in System Settings > Privacy & Security on first launch.

The release, macOS bundle, and application's displayed About version use this
timestamp. Cargo retains the source's semantic version because Cargo does not
accept five-part versions.
EOF

# Publish a draft only after every asset is uploaded. A failed upload can be
# retried with the same run and tag without exposing a partial new release.
release_tags=$(gh api --paginate "repos/$GITHUB_REPOSITORY/releases" --jq '.[].tag_name')
if ! grep -Fxq "$tag" <<< "$release_tags"; then
    gh release create "$tag" --repo "$GITHUB_REPOSITORY" \
        --verify-tag --target "$GITHUB_SHA" --title "$app_name $RELEASE_VERSION" \
        --notes-file "$notes" --draft --prerelease="$prerelease"
fi
gh release upload "$tag" release-assets/* \
    --repo "$GITHUB_REPOSITORY" --clobber
# A slower build of an earlier commit still gets its release, but must not replace
# the download shown as Latest once main has advanced to a newer commit.
latest=false
if [[ "$channel" == stable && "$(gh api "repos/$GITHUB_REPOSITORY/git/ref/heads/main" --jq '.object.sha')" == "$GITHUB_SHA" ]]; then
    latest=true
fi
gh release edit "$tag" --repo "$GITHUB_REPOSITORY" \
    --title "$app_name $RELEASE_VERSION" --notes-file "$notes" \
    --draft=false --prerelease="$prerelease" --latest="$latest"
