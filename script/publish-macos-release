#!/usr/bin/env bash
set -euo pipefail

: "${RELEASE_VERSION:?}"
: "${GITHUB_SHA:?}"
: "${GITHUB_REPOSITORY:?}"

test "$(git rev-parse "refs/tags/$RELEASE_VERSION^{commit}")" = "$GITHUB_SHA"
for architecture in aarch64; do
    test -s "release-assets/Koda-$RELEASE_VERSION-macos-$architecture.dmg"
    test -s "release-assets/koda-remote-server-$RELEASE_VERSION-macos-$architecture.gz"
    (cd release-assets && sha256sum --check "SHA256SUMS-macos-$architecture.txt")
done

notes=$(mktemp)
trap 'rm -f "$notes"' EXIT
cat > "$notes" <<EOF
Optimized macOS production build of commit $GITHUB_SHA.

Version and tag: $RELEASE_VERSION (Asia/Calcutta).

Download the aarch64 DMG for Apple Silicon Macs.
The apps are ad-hoc signed and are not Apple notarized. macOS may require
allowing the application in System Settings > Privacy & Security on first launch.

The release, macOS bundle, and application's displayed About version use this
timestamp. Cargo retains the source's semantic version because Cargo does not
accept five-part versions.
EOF

# Publish a draft only after every asset is uploaded. A failed upload can be
# retried with the same run and tag without exposing a partial new release.
release_tags=$(gh api --paginate "repos/$GITHUB_REPOSITORY/releases" --jq '.[].tag_name')
if ! grep -Fxq "$RELEASE_VERSION" <<< "$release_tags"; then
    gh release create "$RELEASE_VERSION" --repo "$GITHUB_REPOSITORY" \
        --verify-tag --target "$GITHUB_SHA" --title "$RELEASE_VERSION" \
        --notes-file "$notes" --draft
fi
gh release upload "$RELEASE_VERSION" release-assets/* \
    --repo "$GITHUB_REPOSITORY" --clobber
# A slower build of an earlier push still gets its release, but must not replace
# the download shown as Latest once main has advanced to a newer commit.
latest=false
if [[ "$(gh api "repos/$GITHUB_REPOSITORY/git/ref/heads/main" --jq '.object.sha')" == "$GITHUB_SHA" ]]; then
    latest=true
fi
gh release edit "$RELEASE_VERSION" --repo "$GITHUB_REPOSITORY" \
    --title "$RELEASE_VERSION" --notes-file "$notes" --draft=false --latest="$latest"
