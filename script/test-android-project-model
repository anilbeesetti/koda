#!/usr/bin/env python3
"""Exercise real Gradle model and Eclipse projections in temporary flavored projects.

Needs JDK 21, an Android SDK with API 35 and the build-tools required by the AGP version, and Gradle 8.11.1 (AGP 8)
or 9.7.1 (AGP 9). Use --gradle with a matching installed Gradle executable.
Uses the session's proxy/trust configuration unchanged. No emulator is needed.
"""
import argparse
import json
from pathlib import Path
import subprocess
import tempfile
import xml.etree.ElementTree as ET

REPOSITORY = Path(__file__).resolve().parent.parent


def write(root, name, text):
    path = root / name
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)


def fixture(root, agp):
    kotlin_plugin = "id 'org.jetbrains.kotlin.android' version '2.1.20' apply false" if agp.startswith("8.") else ""
    write(root, "settings.gradle", """pluginManagement { repositories { google(); mavenCentral(); gradlePluginPortal() } }
 dependencyResolutionManagement { repositories { google(); mavenCentral() } }
 rootProject.name = 'koda-model-probe'
 include ':app', ':library', ':testing', ':feature'
""")
    write(root, "build.gradle", f"""plugins {{
 id 'com.android.application' version '{agp}' apply false
 id 'com.android.library' version '{agp}' apply false
 id 'com.android.dynamic-feature' version '{agp}' apply false
 {kotlin_plugin}
}}
""")
    kotlin = "apply plugin: 'org.jetbrains.kotlin.android'" if agp.startswith("8.") else ""
    write(root, "app/build.gradle", """plugins { id 'com.android.application' }
""" + kotlin + """
android {
 namespace 'dev.koda.app'; compileSdk 35
 defaultConfig { applicationId 'dev.koda.app'; minSdk 24; targetSdk 35 }
 flavorDimensions 'edition'
 productFlavors { demo { dimension 'edition'; matchingFallbacks = ['free'] }; full { dimension 'edition'; matchingFallbacks = ['free'] } }
 buildTypes { debug { matchingFallbacks = ['release'] } }
 buildFeatures { buildConfig true }
 dynamicFeatures = [':feature']
}
class GeneratedSource extends DefaultTask {
 @OutputDirectory final DirectoryProperty outputDirectory = project.objects.directoryProperty()
 @TaskAction void generate() { def directory = outputDirectory.get().asFile; directory.mkdirs(); new File(directory, 'Generated.java').text = 'package dev.koda.generated; public class Generated {}' }
}
androidComponents.onVariants(androidComponents.selector().all()) { variant ->
 def generated = tasks.register('generate' + variant.name.capitalize() + 'Probe', GeneratedSource) { outputDirectory.set(layout.projectDirectory.dir('probe-generated/' + variant.name)) }
 variant.sources.java.addGeneratedSourceDirectory(generated) { it.outputDirectory }
}
dependencies { implementation project(':library'); testImplementation project(':testing'); testImplementation testFixtures(project(':library')); testImplementation 'junit:junit:4.13.2' }
""")
    write(root, "library/build.gradle", """plugins { id 'com.android.library' }
""" + kotlin + """
android {
 namespace 'dev.koda.library'; compileSdk 35
 defaultConfig { minSdk 24 }
 flavorDimensions 'edition'; productFlavors { free { dimension 'edition' } }
 testFixtures { enable true }
}
androidComponents.beforeVariants(androidComponents.selector().withBuildType('debug')) { it.enable = false }
dependencies { testFixturesImplementation 'junit:junit:4.13.2' }
""")
    write(root, "feature/build.gradle", """plugins { id 'com.android.dynamic-feature' }
""" + kotlin + """
android {
 namespace 'dev.koda.feature'; compileSdk 35
 defaultConfig { minSdk 24 }
 flavorDimensions 'edition'; productFlavors { demo { dimension 'edition'; matchingFallbacks = ['free'] }; full { dimension 'edition'; matchingFallbacks = ['free'] } }
 buildTypes { debug { matchingFallbacks = ['release'] } }
}
dependencies { implementation project(':app') }
""")
    if agp.startswith("8."):
        for module in ["app", "library", "feature"]:
            with (root / module / "build.gradle").open("a") as output:
                output.write("\nkotlin { compilerOptions { jvmTarget = org.jetbrains.kotlin.gradle.dsl.JvmTarget.JVM_1_8 } }\n")
    write(root, "testing/build.gradle", """plugins { id 'java-library' }
abstract class GenerateTestingJava extends DefaultTask {
 @OutputDirectory abstract DirectoryProperty getOutputDirectory()
 @TaskAction void generate() {
  def source = outputDirectory.file('dev/koda/testing/GeneratedHelper.java').get().asFile
  source.parentFile.mkdirs()
  source.text = 'package dev.koda.testing; public class GeneratedHelper {}'
 }
}
def generator = tasks.register('generateTestingJava', GenerateTestingJava) {
 outputDirectory.set(layout.buildDirectory.dir('generated/probe'))
}
sourceSets.main.java.srcDir(generator.flatMap { it.outputDirectory })
""")
    write(root, "testing/src/main/java/Helper.java", "package dev.koda.testing; public class Helper {}\n")
    for module in ["app", "library", "feature"]:
        write(root, f"{module}/src/main/AndroidManifest.xml", '<manifest xmlns:android="http://schemas.android.com/apk/res/android"/>')
        write(root, f"{module}/src/main/java/Example.kt", f"package dev.koda.{module}\nclass Example\n")
    for flavor in ["demo", "full"]:
        write(root, f"app/src/{flavor}/res/values/strings.xml", f'<resources><string name="title">{flavor}</string></resources>')
    write(root, "library/src/testFixtures/java/FixtureHelper.java", "package dev.koda.library; public class FixtureHelper { public org.junit.Test annotation; }\n")
    write(root, "app/src/test/java/ExampleTest.java", "package dev.koda.app; public class ExampleTest { dev.koda.testing.Helper helper; dev.koda.testing.GeneratedHelper generated; dev.koda.library.FixtureHelper fixture; org.junit.Test test; }\n")


def model_from_log(path):
    records = [line.split("=", 1)[1] for line in path.read_text().splitlines() if line.startswith("KODA_ANDROID_PROJECT_MODEL=")]
    assert len(records) == 1, path.read_text()
    return json.loads(records[0])


def normalized_model(probe, root, log):
    return json.loads(subprocess.check_output([probe, root, log, "--model-only"]))


def check_default_variants(root, agp, sdk, gradle, probe):
    root = root / "default-variants"
    write(root, "settings.gradle", "pluginManagement { repositories { google(); mavenCentral(); gradlePluginPortal() } }\ndependencyResolutionManagement { repositories { google(); mavenCentral() } }\nrootProject.name = 'defaults'; include ':app'\n")
    write(root, "build.gradle", f"plugins {{ id 'com.android.application' version '{agp}' apply false }}\n")
    write(root, "local.properties", f"sdk.dir={Path(sdk).resolve()}\n")
    flavors = "flavorDimensions 'edition'; productFlavors { full { dimension 'edition' }; demo { dimension 'edition' } }"
    cases = [
        ("unflavored", "", "", "debug"),
        ("flavored", flavors, "", "demoDebug"),
        ("default-flavor", flavors + "; productFlavors.full.isDefault = true", "", "fullDebug"),
        ("default-build-type", flavors + "; buildTypes.release.isDefault = true", "", "demoRelease"),
        ("combined-defaults", flavors + "; productFlavors.full.isDefault = true; buildTypes.release.isDefault = true", "", "fullRelease"),
        ("filtered-default", flavors + "; productFlavors.full.isDefault = true", "androidComponents.beforeVariants(androidComponents.selector().withName('fullDebug')) { it.enable = false }", "fullRelease"),
        ("custom-build-type", flavors + "; buildTypes { staging { isDefault = true } }", "", "demoStaging"),
        ("ordered-dimensions", "flavorDimensions 'edition', 'tier'; productFlavors { aB { dimension 'edition' }; a { dimension 'edition' }; z { dimension 'tier' }; b { dimension 'tier' } }", "", "aBDebug"),
        ("without-debug", flavors, "androidComponents.beforeVariants(androidComponents.selector().withBuildType('debug')) { it.enable = false }", "demoRelease"),
    ]
    for name, configuration, filtering, expected in cases:
        write(root, "app/build.gradle", f"plugins {{ id 'com.android.application' }}\nandroid {{ namespace 'dev.koda.defaults'; compileSdk 35; defaultConfig {{ applicationId 'dev.koda.defaults'; minSdk 24 }}; {configuration} }}\n{filtering}\n")
        log = root / f"{name}.log"
        with log.open("w") as output:
            result = subprocess.run([gradle, "--console=plain", "--no-configuration-cache", "--parallel", "--max-workers=2", "--init-script", str(REPOSITORY / "crates/android_tools/src/project_model.gradle"), "kodaAndroidProjectModel"], cwd=root, stdout=output, stderr=subprocess.STDOUT)
        if result.returncode:
            raise RuntimeError(log.read_text())
        app = next(module for module in normalized_model(probe, root, log)["modules"] if module["path"] == ":app")
        assert app["defaultVariant"] == expected, (name, expected, app)
        assert expected in {variant["name"] for variant in app["variants"]}, app
        print(f"Passed AGP {agp} default {name}: {expected}", flush=True)


def test_artifact_kind(path, root):
    path = Path(path)
    if path.is_relative_to(root / "testing"):
        return "testing"
    parts = (path.relative_to(root) if path.is_relative_to(root) else path).parts
    if path.name.lower().startswith("junit-") or any(part.lower() == "junit" for part in parts):
        return "junit"
    if any("testfixtures" in part.lower().replace("-", "").replace("_", "") for part in parts):
        return "testFixtures"
    return None


def assert_test_classpath(model, root, expected):
    assert not any(test_artifact_kind(path, root) for path in model["libraries"]), model
    found = {test_artifact_kind(path, root) for path in model["testLibraries"]}
    assert expected <= found, (expected, found, model)


def assert_eclipse_test_entries(path, expected_libraries, expected_sources):
    entries = ET.parse(path).getroot().findall("classpathentry")
    for kind, expected in [("lib", expected_libraries), ("src", expected_sources)]:
        for expected_path in expected:
            matches = [entry for entry in entries if entry.get("kind") == kind and entry.get("path") == expected_path]
            assert len(matches) == 1, (path, kind, expected_path, ET.tostring(ET.parse(path).getroot()))
            assert any(attribute.get("name") == "test" and attribute.get("value") == "true" for attribute in matches[0].findall("attributes/attribute")), (path, expected_path)


def check_multiplatform(root, agp, sdk, gradle, probe):
    root = root / "multiplatform"
    write(root, "settings.gradle", """pluginManagement { repositories { google(); mavenCentral(); gradlePluginPortal() } }
dependencyResolutionManagement { repositories { google(); mavenCentral() } }
rootProject.name = 'koda-multiplatform-probe'; include ':app', ':sharedLogic', ':sharedUtil'
""")
    write(root, "build.gradle", f"""plugins {{
 id 'com.android.application' version '{agp}' apply false
 id 'com.android.kotlin.multiplatform.library' version '{agp}' apply false
 id 'org.jetbrains.kotlin.multiplatform' version '2.2.10' apply false
}}
""")
    write(root, "local.properties", f"sdk.dir={Path(sdk).resolve()}\n")
    write(root, "app/build.gradle", """plugins { id 'com.android.application' }
android { namespace 'dev.koda.app'; compileSdk 35; defaultConfig { applicationId 'dev.koda.app'; minSdk 24 } }
dependencies { implementation project(':sharedLogic') }
""")
    write(root, "app/src/main/AndroidManifest.xml", '<manifest xmlns:android="http://schemas.android.com/apk/res/android"/>')
    write(root, "app/src/main/java/UseShared.java", "package dev.koda.app; public class UseShared { dev.koda.shared.Shared value; }\n")
    write(root, "sharedLogic/build.gradle", """plugins { id 'org.jetbrains.kotlin.multiplatform'; id 'com.android.kotlin.multiplatform.library' }
kotlin {
 androidLibrary {
  namespace = 'dev.koda.shared'; compileSdk = 35; minSdk = 24
  androidResources { enable = true }
  withHostTestBuilder {}; withDeviceTestBuilder { sourceSetTreeName = 'test' }
 }
 jvm()
 sourceSets {
  sharedMain { dependsOn commonMain; dependencies { api project(':sharedUtil') } }
  androidMain { dependsOn sharedMain }
  commonTest.dependencies { implementation 'org.jetbrains.kotlin:kotlin-test:2.2.10' }
 }
}
abstract class GenerateKotlin extends DefaultTask {
 @OutputDirectory abstract DirectoryProperty getOutputDirectory()
 @TaskAction void generate() {
  def source = outputDirectory.file('Generated.kt').get().asFile
  source.parentFile.mkdirs(); source.text = 'package dev.koda.shared; class Generated'
 }
}
androidComponents.onVariants(androidComponents.selector().all()) { variant ->
 def generator = tasks.register('generateSharedKotlin', GenerateKotlin) { outputDirectory.set(layout.projectDirectory.dir('generated/kotlin')) }
 variant.sources.kotlin.addGeneratedSourceDirectory(generator) { it.outputDirectory }
}
""")
    write(root, "sharedUtil/build.gradle", """plugins { id 'org.jetbrains.kotlin.multiplatform'; id 'com.android.kotlin.multiplatform.library' }
kotlin { androidLibrary { namespace = 'dev.koda.util'; compileSdk = 35; minSdk = 24; withJava() }; jvm() }
""")
    for directory in ["commonMain", "sharedMain", "androidMain", "commonTest", "androidHostTest", "androidDeviceTest", "jvmMain"]:
        write(root, f"sharedLogic/src/{directory}/kotlin/{directory}.kt", f"package dev.koda.shared\nclass {directory[0].upper() + directory[1:]}\n")
    write(root, "sharedLogic/src/commonMain/kotlin/Shared.kt", "package dev.koda.shared\nclass Shared\n")
    write(root, "sharedLogic/src/androidMain/res/values/strings.xml", '<resources><string name="title">Shared</string></resources>')
    write(root, "sharedUtil/src/commonMain/kotlin/KotlinHelper.kt", "package dev.koda.util\nclass KotlinHelper\n")
    write(root, "sharedUtil/src/androidMain/java/Helper.java", "package dev.koda.util; public class Helper { KotlinHelper kotlin; }\n")

    def run(log, *arguments, success=True):
        with (root / log).open("w") as output:
            result = subprocess.run([gradle, "--console=plain", "--no-configuration-cache", "--parallel", "--max-workers=2", *arguments], cwd=root, stdout=output, stderr=subprocess.STDOUT)
        if success and result.returncode:
            raise RuntimeError((root / log).read_text())
        return result.returncode

    export = REPOSITORY / "crates/android_tools/src/project_model.gradle"
    run("model.log", "--init-script", str(export), "kodaAndroidProjectModel")
    model = normalized_model(probe, root, root / "model.log")
    shared = next(module for module in model["modules"] if module["path"] == ":sharedLogic")
    assert shared["kind"] == "library" and shared["namespace"] == "dev.koda.shared", shared
    assert shared["defaultVariant"] == "androidMain" and len(shared["variants"]) == 1, shared
    components = {component["scope"]: component for component in shared["variants"][0]["components"]}
    assert set(components) == {"main", "unitTest", "androidTest"}, components
    for scope, expected in [("main", {"commonMain", "sharedMain", "androidMain"}), ("unitTest", {"commonTest", "androidHostTest"}), ("androidTest", {"commonTest", "androidDeviceTest"})]:
        roots = components[scope]["sources"]
        found = {directory for directory in expected if any(Path(source["path"]) == root / f"sharedLogic/src/{directory}/kotlin" for source in roots)}
        assert found == expected, (scope, roots)
        assert not any(source["generated"] for source in roots if any(Path(source["path"]) == root / f"sharedLogic/src/{directory}/kotlin" for directory in expected)), (scope, roots)
        assert not any("jvmMain" in source["path"] for source in roots), roots
    assert not any("commonTest" in source["path"] for source in components["main"]["sources"]), components
    assert {"kind": "project", "module": ":sharedUtil", "variant": "androidMain"} in components["main"]["dependencies"], components
    assert any(source["kind"] == "resources" and Path(source["path"]) == root / "sharedLogic/src/androidMain/res" for source in components["main"]["sources"]), components
    assert any(source["generated"] and Path(source["path"]) == root / "sharedLogic/generated/kotlin" for source in components["main"]["sources"]), components
    assert (root / "sharedLogic/generated/kotlin/Generated.kt").is_file()
    assert not any("kotlin-test" in dependency.get("coordinate", "") for dependency in components["main"]["dependencies"]), components
    for selected in ["debug", "release"]:
        graph = json.loads(subprocess.check_output([probe, root, root / "model.log", ":app", selected]))
        assert graph["variants"] == {":app": selected, ":sharedLogic": "androidMain", ":sharedUtil": "androidMain"}, graph
        run("java.log", "--init-script", graph["javaExport"], f'-Dkoda.android.selection={graph["javaSelection"]}', "zedAndroidJavaModel")
        subprocess.run([probe, root, root / "model.log", ":app", selected, root / "java.log"], check=True, stdout=subprocess.DEVNULL)
        java = json.loads((root / ".koda/android-java/model.json").read_text())
        shared_java = next(module for module in java if module["project"] == ":sharedLogic")
        assert str(root / "sharedLogic/src/commonMain/kotlin") in shared_java["sources"], shared_java
        assert str(root / "sharedLogic/src/commonTest/kotlin") in shared_java["testSources"], shared_java
        assert not any("kotlin-test" in path for path in shared_java["libraries"]), shared_java
        assert any("kotlin-test" in path for path in shared_java["testLibraries"]), shared_java
        util_java = next(module for module in java if module["project"] == ":sharedUtil")
        assert str(root / "sharedUtil/src/androidMain/java") in util_java["sources"], util_java
        assert any((Path(path) / "dev/koda/util/KotlinHelper.class").is_file() for path in util_java["libraries"]), util_java
        assert (root / "sharedUtil/build/intermediates/javac/androidMain/compileAndroidMainJavaWithJavac/classes/dev/koda/util/Helper.class").is_file()
        run("eclipse.log", "--init-script", str(root / ".koda/android-java/import.gradle"), f'-Dzed.android.javaModel={root / ".koda/android-java/model.json"}', ":sharedLogic:eclipseClasspath", ":sharedUtil:eclipseClasspath")
        assert_eclipse_test_entries(root / "sharedLogic/.classpath", [], [Path(path).relative_to(shared_java["directory"]).as_posix() for path in shared_java["testSources"] if path not in shared_java["sources"]])
        assert "without an exclusive lock" not in (root / "java.log").read_text()
    # A failed KMP collector must never publish a partial catalog.
    original = (root / "sharedLogic/build.gradle").read_text()
    write(root, "sharedLogic/build.gradle", original + "\nconfigurations.androidCompileClasspath.incoming.beforeResolve { throw new GradleException('Intentional KMP resolution failure') }\n")
    assert run("failed.log", "--init-script", str(export), "kodaAndroidProjectModel", "--continue", success=False) != 0
    assert "Intentional KMP resolution failure" in (root / "failed.log").read_text()
    assert "KODA_ANDROID_PROJECT_MODEL=" not in (root / "failed.log").read_text()
    write(root, "sharedLogic/build.gradle", original)
    run("recovered.log", "--init-script", str(export), "kodaAndroidProjectModel")
    assert len(model_from_log(root / "recovered.log")["modules"]) == 3
    print(f"Passed AGP {agp}: KMP app dependencies, transitive Android libraries, common/intermediate/platform sources, generated roots, host/device scopes, Kotlin-only and Java-enabled projections, failure/recovery", flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--gradle", required=True)
    parser.add_argument("--sdk", required=True)
    parser.add_argument("--agp", choices=["8.9.1", "9.4.0"], required=True)
    parser.add_argument("--keep", type=Path, help="Use this directory and retain output for inspection")
    parser.add_argument("--defaults-only", action="store_true", help="Run only default-variant exporter checks")
    parser.add_argument("--multiplatform-only", action="store_true", help="Run only Android multiplatform model/Java/Eclipse checks (AGP 9)")
    args = parser.parse_args()
    if args.multiplatform_only and args.agp.startswith("8."):
        parser.error("The multiplatform fixture requires AGP 9")
    temporary = tempfile.TemporaryDirectory(prefix="koda-model-") if args.keep is None else None
    root = (args.keep or Path(temporary.name)).resolve()
    root.mkdir(parents=True, exist_ok=True)
    subprocess.run(["cargo", "build", "--locked", "-p", "android_tools", "--example", "project_model_probe"], cwd=REPOSITORY, check=True)
    metadata = json.loads(subprocess.check_output(["cargo", "metadata", "--no-deps", "--format-version", "1"], cwd=REPOSITORY))
    probe = Path(metadata["target_directory"]) / "debug/examples/project_model_probe"
    if args.defaults_only:
        check_default_variants(root, args.agp, args.sdk, args.gradle, probe)
        return
    fixture(root, args.agp)
    write(root, "local.properties", f"sdk.dir={Path(args.sdk).resolve()}\n")
    if args.multiplatform_only:
        check_multiplatform(root, args.agp, args.sdk, args.gradle, probe)
        return

    def gradle(log, *arguments, success=True, project=root):
        with (project / log).open("w") as output:
            result = subprocess.run([args.gradle, "--console=plain", "--no-configuration-cache", "--parallel", "--max-workers=2", *arguments], cwd=project, stdout=output, stderr=subprocess.STDOUT)
        if success and result.returncode:
            raise RuntimeError((project / log).read_text())
        return result.returncode

    export = REPOSITORY / "crates/android_tools/src/project_model.gradle"
    gradle("model.log", "--init-script", str(export), "kodaAndroidProjectModel")
    model = model_from_log(root / "model.log")
    # Parallel execution exposes foreign-project classpath resolution, which serial execution masks.
    assert "without an exclusive lock" not in (root / "model.log").read_text()
    for module in ["app", "library", "feature", "testing"]:
        assert f"> Task :{module}:kodaAndroidModuleModel" in (root / "model.log").read_text()
    testing_model = next(module for module in model["modules"] if module["path"] == ":testing")
    testing_sources = testing_model["variants"][0]["components"][0]["sources"]
    assert any(source["generated"] and Path(source["path"]) == root / "testing/build/generated/probe" for source in testing_sources)
    assert "> Task :testing:generateTestingJava" in (root / "model.log").read_text()
    assert (root / "testing/build/generated/probe/dev/koda/testing/GeneratedHelper.java").is_file()
    app = next(module for module in model["modules"] if module["path"] == ":app")
    for variant in app["variants"]:
        main_component = next(component for component in variant["components"] if component["scope"] == "main")
        generated = (root / "app/build/generated/java" / ("generate" + variant["name"][0].upper() + variant["name"][1:] + "Probe")) if args.agp.startswith("8.") else root / "app/probe-generated" / variant["name"]
        assert any(source["generated"] and Path(source["path"]) == generated for source in main_component["sources"]), main_component
        assert not any("junit" in dependency.get("coordinate", "") for dependency in main_component["dependencies"])
        if variant["name"].endswith("Debug"):
            assert any(component["scope"] == "unitTest" and any("junit" in dependency.get("coordinate", "") for dependency in component["dependencies"]) for component in variant["components"])
    library = next(module for module in model["modules"] if module["path"] == ":library")
    for variant in library["variants"]:
        fixtures = next(component for component in variant["components"] if component["scope"] == "testFixtures")
        assert any(Path(source["path"]) == root / "library/src/testFixtures/java" for source in fixtures["sources"]), fixtures
        assert any("junit" in dependency.get("coordinate", "") for dependency in fixtures["dependencies"]), fixtures
        main_component = next(component for component in variant["components"] if component["scope"] == "main")
        assert not any("junit" in dependency.get("coordinate", "") for dependency in main_component["dependencies"]), main_component
    for variant in ["demoDebug", "fullDebug"]:
        graph = json.loads(subprocess.check_output([probe, root, root / "model.log", ":app", variant]))
        assert graph["variants"][":library"] == "freeRelease", graph
        assert graph["variants"][":feature"] == variant, graph
        assert graph["variants"][":testing"] == "jvm", graph
        gradle("java.log", "--init-script", graph["javaExport"], f'-Dkoda.android.selection={graph["javaSelection"]}', "zedAndroidJavaModel")
        assert "without an exclusive lock" not in (root / "java.log").read_text()
        for module in ["app", "library", "feature", "testing"]:
            assert f"> Task :{module}:kodaAndroidJavaModuleModel" in (root / "java.log").read_text()
        subprocess.run([probe, root, root / "model.log", ":app", variant, root / "java.log"], check=True, stdout=subprocess.DEVNULL)
        java = json.loads((root / ".koda/android-java/model.json").read_text())
        app_java = next(module for module in java if module["project"] == ":app")
        assert_test_classpath(app_java, root, {"junit", "testing", "testFixtures"})
        generated = (root / "app/build/generated/java" / ("generate" + variant[0].upper() + variant[1:] + "Probe")) if args.agp.startswith("8.") else root / "app/probe-generated" / variant
        assert str(generated) in app_java["sources"] and (generated / "Generated.java").is_file(), app_java
        library_java = next(module for module in java if module["project"] == ":library")
        assert_test_classpath(library_java, root, {"junit"})
        assert str(root / "library/src/testFixtures/java") in library_java["testSources"], library_java
        assert str(root / "library/src/testFixtures/java") not in library_java["sources"], library_java
        gradle("eclipse.log", "--init-script", str(root / ".koda/android-java/import.gradle"), f'-Dzed.android.javaModel={root / ".koda/android-java/model.json"}', ":app:eclipseClasspath", ":library:eclipseClasspath")
        for module in [app_java, library_java]:
            assert_eclipse_test_entries(
                Path(module["directory"]) / ".classpath",
                [path for path in module["testLibraries"] if test_artifact_kind(path, root)],
                [Path(path).relative_to(module["directory"]).as_posix() for path in module["testSources"] if path not in module["sources"]],
            )
    subprocess.run([probe, root, root / "model.log", ":app", "demoDebug"], check=True, stdout=subprocess.DEVNULL)
    for module in ["app", "feature"]:
        with (root / module / "build.gradle").open("a") as output:
            output.write("\nandroidComponents.beforeVariants(androidComponents.selector().all()) { variant -> if (variant.name == 'demoDebug') variant.enable = false }\n")
    gradle("removed.log", "--init-script", str(export), "kodaAndroidProjectModel")
    removed_model = model_from_log(root / "removed.log")
    app = next(module for module in removed_model["modules"] if module["path"] == ":app")
    assert "demoDebug" not in {variant["name"] for variant in app["variants"]}, app
    removed = subprocess.run([probe, root, root / "removed.log", ":app", "demoDebug"], text=True, capture_output=True)
    assert removed.returncode != 0 and "unavailable" in removed.stderr, removed
    subprocess.run([probe, root, root / "removed.log", ":app", "fullDebug"], check=True, stdout=subprocess.DEVNULL)
    fixture(root, args.agp)
    gradle("restored.log", "--init-script", str(export), "kodaAndroidProjectModel")
    testing = (root / "testing/build.gradle").read_text()
    write(root, "testing/build.gradle", testing + "\nconfigurations.compileClasspath.incoming.beforeResolve { throw new GradleException('Intentional collector resolution failure') }\n")
    assert gradle("collector-failed.log", "--init-script", str(export), "kodaAndroidProjectModel", "--continue", success=False) != 0
    failed_collection = (root / "collector-failed.log").read_text()
    assert "Intentional collector resolution failure" in failed_collection
    assert "> Task :library:kodaAndroidModuleModel" in failed_collection
    assert "KODA_ANDROID_PROJECT_MODEL=" not in failed_collection
    write(root, "testing/build.gradle", testing)
    gradle("collector-recovery.log", "--init-script", str(export), "kodaAndroidProjectModel")
    assert len(model_from_log(root / "collector-recovery.log")["modules"]) == 4
    subprocess.run([probe, root, root / "restored.log", ":app", "demoDebug"], check=True, stdout=subprocess.DEVNULL)
    write(root, "build.gradle", "throw new GradleException('Intentional failed sync')")
    assert gradle("failed.log", "--init-script", str(export), "kodaAndroidProjectModel", success=False) != 0
    fixture(root, args.agp)
    gradle("recovery.log", "--init-script", str(export), "kodaAndroidProjectModel")
    subprocess.run([probe, root, root / "recovery.log", ":app", "demoDebug"], check=True, stdout=subprocess.DEVNULL)
    write(root, "included/settings.gradle", "rootProject.name = 'included'\n")
    write(root, "included/build.gradle", "")
    with (root / "settings.gradle").open("a") as output:
        output.write("includeBuild 'included'\n")
    assert gradle("included.log", "--init-script", str(export), "kodaAndroidProjectModel", success=False) != 0
    assert "does not yet support included builds" in (root / "included.log").read_text()
    root_module = root / "root-jvm"
    write(root_module, "settings.gradle", "rootProject.name = 'root-jvm'; include ':helper'\n")
    write(root_module, "build.gradle", "plugins { id 'java-library' }; dependencies { testImplementation project(':helper') }\n")
    write(root_module, "helper/build.gradle", "plugins { id 'java-library' }\n")
    gradle("model.log", "--init-script", str(export), "kodaAndroidProjectModel", project=root_module)
    root_model = model_from_log(root_module / "model.log")
    assert [module["path"] for module in root_model["modules"]] == [":", ":helper"]
    assert root_model["modules"][0]["variants"][0]["components"][1]["dependencies"] == [{"kind": "project", "module": ":helper", "variant": "jvm"}]
    assert root_model["diagnostics"]  # A root JVM module remains catalogued, without a runnable APK.
    check_default_variants(root, args.agp, args.sdk, args.gradle, probe)
    if not args.agp.startswith("8."):
        check_multiplatform(root, args.agp, args.sdk, args.gradle, probe)
    print(f"Passed AGP {args.agp}: parallel model/Java/Eclipse collection, flavors, fallback library, dynamic feature, registered generated sources, test fixtures, removed/restored variant, collector/configuration failure and recovery, included-build diagnostic, root JVM module")


if __name__ == "__main__":
    main()
