#!/usr/bin/env bash
set -euo pipefail

repository=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export ZED_RELEASE_CHANNEL=dev
export RELEASE_CHANNEL=dev
build_profile=debug
build=true
profile="$repository/target/android-ide/dev/profile"
kotlin_backend=${ANDROID_IDE_KOTLIN_BACKEND:-official}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --release) build_profile=release; shift ;;
        --skip-build) build=false; shift ;;
        --kotlin-backend)
            [[ $# -ge 2 && -n "$2" ]] || { echo "--kotlin-backend requires official" >&2; exit 2; }
            kotlin_backend=$2
            shift 2
            ;;
        --profile)
            [[ $# -ge 2 && -n "$2" ]] || { echo "--profile requires a directory" >&2; exit 2; }
            profile=$2
            shift 2
            ;;
        --help|-h)
            cat <<'USAGE'
Usage: script/android-ide [--release] [--skip-build] [--profile DIR]
                          [--kotlin-backend official] [--] [PATH ...]

Build and run the Android IDE development app on macOS. Paths are resolved from
your current directory. Settings and extensions use target/android-ide/dev/profile
unless --profile is supplied. Existing profile settings are preserved.

Prerequisites: the repository's Rust toolchain, Xcode with Metal tools, Android
SDK, and a Gradle-compatible JDK. Kotlin setup additionally needs
JDK 21. Run script/install-android-kotlin for the pinned JetBrains Kotlin server
with its bundled Java 25 runtime. Run Android: Configure Kotlin in the project
to apply it to existing settings. Set ANDROID_IDE_OFFICIAL_KOTLIN_SERVER to use
a custom path to the tested official distribution.
Run script/install-android-debugger for Java/Kotlin breakpoints and stepping.
Compose preview dependencies are bundled automatically by Cargo.
The Android Studio runtime is used for Gradle when JAVA_HOME is unset.

The launcher honors CARGO_TARGET_DIR and LK_CUSTOM_WEBRTC. Set CARGO_BUILD_JOBS
to limit build concurrency. Quit this development app before rebuilding it.
USAGE
            exit 0
            ;;
        --) shift; break ;;
        -*) echo "Unknown launcher option: $1" >&2; exit 2 ;;
        *) break ;;
    esac
done

case "$kotlin_backend" in
    official) kotlin_server_id=kotlin-lsp ;;
    *) echo "Unknown Kotlin backend: $kotlin_backend; only official is supported." >&2; exit 2 ;;
esac
export ANDROID_IDE_KOTLIN_BACKEND="$kotlin_backend"
kotlin_official_server="$repository/target/android-ide/dependencies/kotlin-lsp-263.4702.0+android-6/kotlin-server-263.4702.0/bin/intellij-server"
if [[ -z ${ANDROID_IDE_OFFICIAL_KOTLIN_SERVER:-} && -x "$kotlin_official_server" ]]; then
    export ANDROID_IDE_OFFICIAL_KOTLIN_SERVER="$kotlin_official_server"
fi
if [[ -n ${ANDROID_IDE_OFFICIAL_KOTLIN_SERVER:-} && ! -x "$ANDROID_IDE_OFFICIAL_KOTLIN_SERVER" ]]; then
    echo "Missing official Kotlin LSP at the explicit override; clear ANDROID_IDE_OFFICIAL_KOTLIN_SERVER or choose a valid executable." >&2
    exit 1
fi

[[ $(uname -s) == Darwin ]] || { echo "This development launcher currently supports macOS." >&2; exit 1; }
case "$profile" in /*) ;; *) profile="$PWD/$profile" ;; esac
target_directory=${CARGO_TARGET_DIR:-"$repository/target"}
case "$target_directory" in /*) ;; *) target_directory="$PWD/$target_directory" ;; esac
export CARGO_TARGET_DIR="$target_directory"

bundle="$repository/target/android-ide/dev/$build_profile/Koda Dev.app"
executable="$bundle/Contents/MacOS/koda"
if ps -axo command= | /usr/bin/grep -F "$executable" | /usr/bin/grep -v '[g]rep' >/dev/null; then
    echo "Quit the $build_profile Koda Dev app before running this launcher again." >&2
    exit 1
fi

if $build; then
    arguments=(build --locked -p zed --bin koda)
    if [[ $build_profile == release ]]; then arguments+=(--release); fi
    (cd "$repository" && cargo "${arguments[@]}")
fi
binary="$target_directory/$build_profile/koda"
[[ -x "$binary" ]] || { echo "Missing $binary; run again without --skip-build." >&2; exit 1; }

# A previously built Nightly executable must not acquire a Dev bundle identity.
# Inspect its compiled channel without runtime overrides or touching real profiles.
binary_specs=$(
    unset ZED_RELEASE_CHANNEL RELEASE_CHANNEL
    "$binary" --user-data-dir "$profile" --system-specs
) || { echo "Could not verify the development binary's channel." >&2; exit 1; }
case "$binary_specs" in
    *"(Koda Dev)"*|*"(Koda Dev "*) ;;
    *) echo "Existing binary is not Koda Dev; run again without --skip-build to rebuild." >&2; exit 1 ;;
esac

mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources" "$profile/config"
cat > "$bundle/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>dev.anilbeesetti.koda-dev</string>
<key>CFBundleName</key><string>Koda Dev</string>
<key>CFBundleDisplayName</key><string>Koda Dev</string>
<key>CFBundleIconFile</key><string>KodaDev.icns</string>
<key>CFBundleExecutable</key><string>koda</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleVersion</key><string>0.1</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
cp "$repository/crates/zed/resources/KodaDev.icns" "$bundle/Contents/Resources/KodaDev.icns"
# A real executable keeps macOS app discovery attached to this bundle.
cp -c "$binary" "$executable" || cp "$binary" "$executable"

if [[ ! -e "$profile/config/settings.json" ]]; then
    python3 - "$profile/config/settings.json" "${ANDROID_IDE_OFFICIAL_KOTLIN_SERVER:-}" <<'SETTINGS'
import json
from pathlib import Path
import sys

settings = {
    "auto_update": False,
    "telemetry": {"diagnostics": False, "metrics": False},
    "auto_install_extensions": {"kotlin": True, "java": True},
    "languages": {"Kotlin": {"language_servers": ["kotlin-lsp"]}},
}
if sys.argv[2]:
    settings["lsp"] = {"kotlin-lsp": {"binary": {
        "path": str(Path(sys.argv[2]).resolve()),
        "arguments": ["--stdio", "--data-sharing=none"],
    }}}
Path(sys.argv[1]).write_text(json.dumps(settings, indent=2) + "\n")
SETTINGS
fi

studio_java="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
if [[ -z ${JAVA_HOME:-} && -x "$studio_java/bin/java" ]]; then
    export JAVA_HOME="$studio_java"
fi
if [[ -z ${ANDROID_HOME:-} && -z ${ANDROID_SDK_ROOT:-} && -d "$HOME/Library/Android/sdk" ]]; then
    export ANDROID_HOME="$HOME/Library/Android/sdk"
fi

kotlin_debugger="$repository/target/android-ide/dependencies/kotlin-debug-adapter/bin/kotlin-debug-adapter"
if [[ -z ${ANDROID_IDE_KOTLIN_DEBUGGER:-} && -x "$kotlin_debugger" ]]; then
    export ANDROID_IDE_KOTLIN_DEBUGGER="$kotlin_debugger"
fi

echo "App: $bundle"
echo "Profile: $profile"
echo "Kotlin backend: $kotlin_backend ($kotlin_server_id)"
exec "$executable" --user-data-dir "$profile" "$@"
