    }
  },
  "implementation": "crates/android_tools/src/gradle_import.rs",
  "accepted_dsl": {
    "settings": [
      "Literal Groovy/Kotlin include statements (optional parentheses and Kotlin trailing comma)",
      "Literal project(name).projectDir = new File(path), File(path), or file(path)",
      "Literal rootProject.name assignment"
    ],
    "build": [
      "Literal apply plugin: string / apply(plugin = string)",
      "Top-level dependencies with literal external artifact or literal project reference, including path: / path = arguments",
      "plugins, android, and repositories blocks retained as opaque non-dependency configuration; nested dependency declarations and nonliteral apply are rejected"
    ],
    "unsupported_policy": "All other top-level build/settings statements, dynamic/conditional/receiver dependencies, applied scripts, interpolated strings, unrecognized literals and incomplete token structures return an error before staging copies. This reads declarations, not Gradle runtime/plugin-generated dependencies; evaluated support is a later adapter."
  },
  "behavior_adaptations": [
    "Rust filesystem paths and explicit Result values replace IntelliJ VirtualFile, DSL services and write actions while retaining every applicable upstream assertion.",
    "The backend returns registration results; desktop wizard/action and successful-sync scheduling remain lead-owned product wiring.",
    "Existing unrelated destination directories/logical registrations are rejected rather than destructively replaced. Symlink/special-file entries within external copies and custom paths containing controls are rejected before publication. Supplied root paths are canonicalized. Callers serialize target edits and perform work on a background executor."
  ],
